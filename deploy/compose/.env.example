# ReleaseHub open-source single-server deployment.
# Copy this file to .env and change every secret before starting.

COMPOSE_PROJECT_NAME=releasehub

# Public URL used by browsers to access the frontend.
APP_BASE_URL=http://localhost:8090

# Host ports. Keep BACKEND_PORT bound to localhost or firewall-protected in production.
FRONTEND_PORT=8090
BACKEND_PORT=8080

# PostgreSQL container database.
POSTGRES_DB=releasehub
POSTGRES_USER=releasehub
POSTGRES_PASSWORD=change-me-postgres-password

# Spring Boot profile for production with real GitLab adapters.
SPRING_PROFILES_ACTIVE=prd,real

# 首次空库部署必须自行设置密码：至少 12 个字符，UTF-8 不超过 72 字节。
# 成功登录后清空此密码并重建后端容器；已有账户不会被重置。
RELEASEHUB_BOOTSTRAP_ADMIN_USERNAME=admin
RELEASEHUB_BOOTSTRAP_ADMIN_PASSWORD=

# Use a strong random value with at least 32 bytes.
JWT_SECRET=change-me-at-least-32-bytes-long

# Git Token 加密密钥：首次新部署使用 openssl rand -base64 32 生成。
# 必须独立安全备份；已有加密实例必须填写原密钥，不得每次部署重新生成。
RELEASEHUB_CRYPTO_SECRET_KEY=

# Browser origins allowed by the backend. For a real domain, use https://your.domain.
CORS_ALLOWED_ORIGINS=http://localhost:8090

# JVM tuning. Adjust for your server size.
JAVA_OPTS=-Xms512m -Xmx1024m

# Frontend API base inside browser. /api is proxied by the frontend Nginx container.
VITE_API_BASE_URL=/api
